# Copy values into .env. Never commit real credentials.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-luna
OPENAI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Opt in only for synthetic/consented transcripts. Default: content hidden.
MILAI_TRACE_CONTENT=false
MILAI_DATABASE=.milai/learning.sqlite3
